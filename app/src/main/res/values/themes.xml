<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UniCare" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#0D6EFD</item>
        <item name="colorPrimaryVariant">#0852C8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">#00C4A7</item>
        <item name="colorSecondaryVariant">#00A089</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- Surface -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A1A2E</item>
        <!-- Background -->
        <item name="android:colorBackground">#F0F4FF</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">#0852C8</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Text fields -->
        <item name="materialButtonStyle">@style/Widget.UniCare.Button</item>
        <item name="textInputStyle">@style/Widget.UniCare.TextInputLayout</item>
    </style>

    <style name="Widget.UniCare.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">#0D6EFD</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.UniCare.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#0D6EFD</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">#0D6EFD</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.UniCare.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeColor">#CBD5F5</item>
        <item name="hintTextColor">#6B7280</item>
    </style>

    <style name="Theme.UniCare.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.UniCare.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
