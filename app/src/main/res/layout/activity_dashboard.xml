<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER HERO ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="188dp"
            android:background="@drawable/gradient_header">

            <View android:layout_width="180dp" android:layout_height="180dp"
                android:layout_alignParentEnd="true" android:layout_marginTop="-40dp"
                android:layout_marginEnd="-60dp" android:alpha="0.10"
                android:background="@drawable/bg_icon_circle_blue"/>
            <View android:layout_width="100dp" android:layout_height="100dp"
                android:layout_alignParentEnd="true" android:layout_marginTop="60dp"
                android:layout_marginEnd="20dp" android:alpha="0.08"
                android:background="@drawable/bg_icon_circle_blue"/>

            <!-- Logo -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="24dp" android:layout_marginTop="26dp"
                android:gravity="center_vertical" android:orientation="horizontal">

                <TextView android:layout_width="46dp" android:layout_height="46dp"
                    android:background="@drawable/bg_splash_logo" android:gravity="center"
                    android:text="✚" android:textColor="#0D6EFD" android:textSize="22sp"
                    android:textStyle="bold"/>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="UniCare" android:textColor="#FFFFFF" android:textSize="24sp"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Chăm sóc sức khoẻ thông minh" android:textColor="#C7D9FF" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Welcome text -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="24dp" android:layout_marginTop="91dp"
                android:orientation="vertical">
                <TextView android:id="@+id/txtWelcome" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Xin chào! 👋"
                    android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:background="@drawable/bg_splash_logo"
                    android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                    <TextView android:id="@+id/txtRole" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Bệnh nhân"
                        android:textColor="#0D6EFD" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- ===== PATIENT SECTION (shown for patients) ===== -->
        <LinearLayout android:id="@+id/sectionPatient"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Quick Stats Row (patient) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="-18dp"
                android:orientation="horizontal">
                <androidx.cardview.widget.CardView android:id="@+id/statCardAppointments"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp" app:cardElevation="6dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏥" android:textSize="20sp"/>
                        <TextView android:id="@+id/statCountAppointments" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0" android:textColor="#0D6EFD" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Lịch khám" android:textColor="#6B7280" android:textSize="10sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/statCardMedication"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="3dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp" app:cardElevation="6dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💊" android:textSize="20sp"/>
                        <TextView android:id="@+id/statCountMedication" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0" android:textColor="#F59E0B" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Thuốc" android:textColor="#6B7280" android:textSize="10sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/statCardHealth"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp" app:cardElevation="6dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="20sp"/>
                        <TextView android:id="@+id/statCountHealth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0" android:textColor="#10B981" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Sức khoẻ" android:textColor="#6B7280" android:textSize="10sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Section: Dịch vụ -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp" android:layout_marginTop="20dp"
                android:text="Dịch vụ y tế" android:textColor="#1A1A2E" android:textSize="17sp" android:textStyle="bold"/>

            <!-- Book Appointment -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:padding="16dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="50dp" android:layout_height="50dp"
                        android:background="@drawable/bg_icon_circle_blue" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_calendar" android:contentDescription="Đặt lịch"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Đặt lịch khám" android:textColor="#1A1A2E" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="Chọn bác sĩ, ngày &amp; giờ phù hợp"
                            android:textColor="#9CA3AF" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBook"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Đặt ngay" android:textSize="12sp" android:textAllCaps="false"
                        style="@style/Widget.UniCare.Button" app:cornerRadius="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Appointments -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:padding="16dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="50dp" android:layout_height="50dp"
                        android:background="@drawable/bg_icon_circle_teal" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_schedule" android:contentDescription="Lịch"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Quản lý lịch khám" android:textColor="#1A1A2E" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="Xem và theo dõi lịch hẹn"
                            android:textColor="#9CA3AF" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAppointments"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Xem" android:textSize="12sp" android:textAllCaps="false"
                        style="@style/Widget.UniCare.Button" android:backgroundTint="#00C4A7" app:cornerRadius="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NEW: Health Vitals -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:padding="16dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="50dp" android:layout_height="50dp"
                        android:background="@drawable/bg_icon_circle_red" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="❤️" android:textSize="22sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Chỉ số sức khoẻ" android:textColor="#1A1A2E" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="8dp" android:background="@drawable/bg_badge_green"
                                android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                                android:text="MỚI" android:textColor="#10B981" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="Huyết áp, nhịp tim, cân nặng..."
                            android:textColor="#9CA3AF" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnHealthVitals"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Theo dõi" android:textSize="12sp" android:textAllCaps="false"
                        style="@style/Widget.UniCare.Button" android:backgroundTint="#FF6B6B" app:cornerRadius="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NEW: Medication Tracker -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:padding="16dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="50dp" android:layout_height="50dp"
                        android:background="@drawable/bg_icon_circle_amber" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💊" android:textSize="22sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Nhắc nhở thuốc" android:textColor="#1A1A2E" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="8dp" android:background="@drawable/bg_badge_green"
                                android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                                android:text="MỚI" android:textColor="#10B981" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="Lịch uống thuốc hàng ngày"
                            android:textColor="#9CA3AF" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMedication"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mở" android:textSize="12sp" android:textAllCaps="false"
                        style="@style/Widget.UniCare.Button" android:backgroundTint="#F59E0B" app:cornerRadius="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Records + Notifications row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp"
                    app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="18dp">
                        <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle_amber" android:gravity="center">
                            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                                android:src="@drawable/ic_medical_record" android:contentDescription="Hồ sơ"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="Hồ sơ bệnh án"
                            android:textColor="#1A1A2E" android:textSize="13sp" android:textStyle="bold" android:gravity="center"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRecords"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="Xem" android:textSize="12sp"
                            android:textAllCaps="false" style="@style/Widget.UniCare.Button.Outlined" app:cornerRadius="10dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="18dp">
                        <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle_red" android:gravity="center">
                            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                                android:src="@drawable/ic_notification" android:contentDescription="Thông báo"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="Thông báo"
                            android:textColor="#1A1A2E" android:textSize="13sp" android:textStyle="bold" android:gravity="center"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNotices"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="Xem" android:textSize="12sp"
                            android:textAllCaps="false" style="@style/Widget.UniCare.Button.Outlined" app:cornerRadius="10dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>

        <!-- ===== DOCTOR SECTION (shown for doctors) ===== -->
        <LinearLayout android:id="@+id/sectionDoctor"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Quick Stats Row (doctor) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="-18dp"
                android:orientation="horizontal">
                <androidx.cardview.widget.CardView android:id="@+id/drStatCardPatients"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp" app:cardElevation="6dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="20sp"/>
                        <TextView android:id="@+id/drStatCountPatients" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0" android:textColor="#0D6EFD" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Bệnh nhân" android:textColor="#6B7280" android:textSize="10sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/drStatCardToday"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="3dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp" app:cardElevation="6dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="20sp"/>
                        <TextView android:id="@+id/drStatCountToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0" android:textColor="#10B981" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Hôm nay" android:textColor="#6B7280" android:textSize="10sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/drStatCardRating"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp" app:cardElevation="6dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐" android:textSize="20sp"/>
                        <TextView android:id="@+id/drStatCountRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="--" android:textColor="#F59E0B" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Đánh giá" android:textColor="#6B7280" android:textSize="10sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrVitals"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
                android:text="📊 Nhập chỉ số sức khỏe cho bệnh nhân"
                android:textAllCaps="false" style="@style/Widget.UniCare.Button" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDrMedication"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
                android:text="💊 Kê lịch uống thuốc cho bệnh nhân"
                android:textAllCaps="false" style="@style/Widget.UniCare.Button" />

            <!-- Section: Công cụ bác sĩ -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp" android:layout_marginTop="20dp"
                android:text="Công cụ bác sĩ" android:textColor="#1A1A2E" android:textSize="17sp" android:textStyle="bold"/>

            <!-- Appointments management -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_blue" android:gravity="center">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_schedule" android:contentDescription="Lịch"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Quản lý lịch hẹn" android:textColor="#1A1A2E" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="1dp" android:text="Xác nhận, từ chối, nhập bệnh án"
                            android:textColor="#9CA3AF" android:textSize="11sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDrAppointments"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Quản lý" android:textSize="11sp" android:textAllCaps="false"
                        android:minHeight="36dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                        style="@style/Widget.UniCare.Button" app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NEW: Doctor Stats -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_teal" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="18sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Thống kê hoạt động" android:textColor="#1A1A2E" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="1dp" android:text="Tổng quan lịch khám, đánh giá"
                            android:textColor="#9CA3AF" android:textSize="11sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDoctorStats"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Xem" android:textSize="11sp" android:textAllCaps="false"
                        android:minHeight="36dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                        style="@style/Widget.UniCare.Button" android:backgroundTint="#00C4A7" app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NEW: Doctor Schedule -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_amber" android:gravity="center">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_calendar" android:contentDescription="Lịch"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Lịch làm việc" android:textColor="#1A1A2E" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="1dp" android:text="Quản lý khung giờ khám bệnh"
                            android:textColor="#9CA3AF" android:textSize="11sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDoctorSchedule"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cài đặt" android:textSize="11sp" android:textAllCaps="false"
                        android:minHeight="36dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                        style="@style/Widget.UniCare.Button" android:backgroundTint="#F59E0B" app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Medical Records (doctor) -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_red" android:gravity="center">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_medical_record" android:contentDescription="Bệnh án"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Bệnh án bệnh nhân" android:textColor="#1A1A2E" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="1dp" android:text="Xem &amp; nhập kết quả khám"
                            android:textColor="#9CA3AF" android:textSize="11sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDrRecords"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mở" android:textSize="11sp" android:textAllCaps="false"
                        android:minHeight="36dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                        style="@style/Widget.UniCare.Button" android:backgroundTint="#FF6B6B" app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ===== SHARED BOTTOM: Profile + Logout ===== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/bg_icon_circle_green" android:gravity="center">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_person" android:contentDescription="Cá nhân"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="Hồ sơ cá nhân"
                        android:textColor="#1A1A2E" android:textSize="13sp" android:textStyle="bold"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnProfile"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="Chỉnh sửa" android:textSize="12sp"
                        android:textAllCaps="false" style="@style/Widget.UniCare.Button.Outlined" app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/bg_badge_red" android:gravity="center">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_logout" android:contentDescription="Đăng xuất"
                            android:tint="#EF4444"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="Đăng xuất"
                        android:textColor="#1A1A2E" android:textSize="13sp" android:textStyle="bold"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="Thoát" android:textSize="12sp"
                        android:textAllCaps="false" style="@style/Widget.UniCare.Button"
                        android:backgroundTint="#EF4444" app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp" android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp" android:gravity="center"
            android:text="UniCare v2.0 • Dữ liệu minh họa học tập"
            android:textColor="#C4C9D4" android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>
