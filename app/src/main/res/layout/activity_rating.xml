<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_header"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle_blue"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Quay lại"
                android:padding="10dp"
                android:alpha="0.85"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đánh giá bác sĩ"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chia sẻ trải nghiệm khám bệnh"
                    android:textColor="#C7D9FF"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Doctor info card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_icon_circle_blue"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_person"
                        android:contentDescription="Bác sĩ"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDoctorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="BS. Nguyễn Văn A"
                    android:textColor="#1A1A2E"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtSpecialty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Nội khoa"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtVisitDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Star rating card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn cảm thấy thế nào?"
                    android:textColor="#1A1A2E"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtRatingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Chạm vào sao để đánh giá"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"/>

                <!-- Star buttons row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/star1" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="☆" android:textSize="36sp" android:textColor="#F59E0B" android:padding="4dp"/>
                    <TextView android:id="@+id/star2" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="☆" android:textSize="36sp" android:textColor="#F59E0B" android:padding="4dp"/>
                    <TextView android:id="@+id/star3" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="☆" android:textSize="36sp" android:textColor="#F59E0B" android:padding="4dp"/>
                    <TextView android:id="@+id/star4" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="☆" android:textSize="36sp" android:textColor="#F59E0B" android:padding="4dp"/>
                    <TextView android:id="@+id/star5" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="☆" android:textSize="36sp" android:textColor="#F59E0B" android:padding="4dp"/>
                </LinearLayout>

                <!-- Quick tag chips -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Chọn nhận xét nhanh:"
                    android:textColor="#6B7280"
                    android:textSize="13sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView android:id="@+id/chipFriendly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:background="@drawable/bg_section" android:paddingHorizontal="14dp" android:paddingVertical="7dp" android:text="Thân thiện" android:textColor="#6B7280" android:textSize="12sp"/>
                    <TextView android:id="@+id/chipProfessional" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:background="@drawable/bg_section" android:paddingHorizontal="14dp" android:paddingVertical="7dp" android:text="Chuyên nghiệp" android:textColor="#6B7280" android:textSize="12sp"/>
                    <TextView android:id="@+id/chipOnTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:background="@drawable/bg_section" android:paddingHorizontal="14dp" android:paddingVertical="7dp" android:text="Đúng giờ" android:textColor="#6B7280" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView android:id="@+id/chipCareful" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:background="@drawable/bg_section" android:paddingHorizontal="14dp" android:paddingVertical="7dp" android:text="Tận tâm" android:textColor="#6B7280" android:textSize="12sp"/>
                    <TextView android:id="@+id/chipExplain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:background="@drawable/bg_section" android:paddingHorizontal="14dp" android:paddingVertical="7dp" android:text="Giải thích rõ" android:textColor="#6B7280" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Comment card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✍️  Nhận xét thêm"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Chia sẻ trải nghiệm của bạn (tùy chọn)..."
                    style="@style/Widget.UniCare.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtComment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:lines="4"
                        android:gravity="top"
                        android:minHeight="100dp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Submit button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:text="⭐  Gửi đánh giá"
            android:minHeight="56dp"
            android:textAllCaps="false"
            android:textSize="17sp"
            style="@style/Widget.UniCare.Button"
            android:backgroundTint="#F59E0B"
            app:cornerRadius="16dp"/>

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#10B981"/>

        <View android:layout_width="match_parent" android:layout_height="32dp"/>
    </LinearLayout>
</ScrollView>
