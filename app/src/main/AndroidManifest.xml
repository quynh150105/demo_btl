<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:theme="@style/Theme.UniCare"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- ===== LAUNCHER (Splash Screen) ===== -->
        <activity android:name=".SplashActivity" android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ===== AUTH ===== -->
        <activity android:name=".AuthActivity" android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- ===== CORE ===== -->
        <activity android:name=".DashboardActivity" android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name=".ProfileActivity" android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name=".BookingActivity" android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name=".AppointmentsActivity" android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name=".RecordsActivity" android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name=".RecordEditorActivity" android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- ===== NEW PATIENT FEATURES ===== -->
        <activity android:name=".HealthVitalsActivity" android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name=".MedicationActivity" android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name=".RatingActivity" android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- ===== NEW DOCTOR FEATURES ===== -->
        <activity android:name=".DoctorStatsActivity" android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name=".DoctorScheduleActivity" android:exported="false"
            android:screenOrientation="portrait"/>

    </application>
</manifest>
